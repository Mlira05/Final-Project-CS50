{
  "name": "cs50-personal-finances",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.functions.json && vite build",
    "lint": "eslint .",
    "test:openfinance": "node --experimental-strip-types --experimental-specifier-resolution=node scripts/test-openfinance.ts",
    "preview": "vite preview",
    "pages:dev": "npm run build && wrangler pages dev dist --d1 DB=cs50-personal-finances-db",
    "d1:create": "wrangler d1 create cs50-personal-finances-db",
    "d1:migrate:local": "wrangler d1 migrations apply cs50-personal-finances-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply cs50-personal-finances-db --remote",
    "deploy": "npm run build && wrangler pages deploy dist --project-name cs50-personal-finances"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260902.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "tailwindcss": "^4.2.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.2.2",
    "wrangler": "^4.128.0"
  }
}
